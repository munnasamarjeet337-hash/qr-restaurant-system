# Server Port
PORT=5000

# Client Application URL for CORS (e.g. http://localhost:5173 or https://your-frontend.vercel.app)
CLIENT_URL=http://localhost:5173

# PostgreSQL / Supabase Database URL (Optional - defaults to auto-initialized in-memory/sqlite store)
DATABASE_URL=postgresql://postgres:password@localhost:5432/restaurant_db?schema=public

# Environment
NODE_ENV=development
